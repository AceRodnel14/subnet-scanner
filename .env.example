# Copy to .env and fill it in BEFORE the first start (secrets are left empty on purpose). Every variable the app reads is listed here and in the README.

# --- App ---
PORT=8080
# Public URL as users see it (https://... behind a reverse proxy)
BASE_URL=http://localhost:8080
LOG_LEVEL=info
# Subnet pre-filled in the UI
DEFAULT_SUBNET=192.168.1.0/24
# Optional path to a custom icon inside the container, e.g. /icon/favicon.ico (see the commented mount in docker-compose.yml)
ICON=

# --- Compose ---
# IMAGE=eacer/subnet-scanner:v1.0
# APP_BIND=127.0.0.1   # publish on loopback only when a proxy fronts the app
# APP_PORT=8080
